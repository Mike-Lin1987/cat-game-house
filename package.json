{
  "name": "game-house",
  "version": "1.1.0",
  "private": true,
  "description": "可安裝、可離線且可持續新增遊戲的單機網頁遊戲入口",
  "scripts": {
    "build": "node scripts/build-site.js",
    "test": "node --test",
    "generate-levels": "node scripts/generate-levels.js",
    "generate-cat-connect-levels": "node scripts/cat-color-connect/generate-levels.js",
    "validate-cat-connect-levels": "node scripts/cat-color-connect/validate-levels.js",
    "validate-levels": "node --test tests/levels.test.js tests/packs.test.js",
    "validate-offline": "node scripts/validate-offline.js",
    "verify": "npm run validate-cat-connect-levels && npm run validate-offline && npm test && npm run build"
  }
}
